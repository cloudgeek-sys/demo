
# ==========================================
# POWERSHELL USER PROFILE
# ==========================================

# Python Installation
$env:PYTHON_HOME = "C:\Program Files\Python313"

# Pip Installation
$env:PIP_HOME = "$env:PYTHON_HOME\Scripts"

# Add Python and Pip directories to PATH
$pythonPaths = @(
    $env:PYTHON_HOME
    $env:PIP_HOME
)

foreach ($path in $pythonPaths) {
    if ((Test-Path $path) -and
        (($env:PATH -split ';') -notcontains $path)) {
        $env:PATH = "$path;$env:PATH"
    }
}

# ==========================================
# PYTHON SHORTCUTS
# ==========================================

function python-version {
    python --version
}

function pip-version {
    python -m pip --version
}

# ==========================================
# STARTUP INFORMATION
# ==========================================

Write-Host "PowerShell Profile Loaded" -ForegroundColor Green
Write-Host "Python Home: $env:PYTHON_HOME" -ForegroundColor Cyan
Write-Host "Pip Home: $env:PIP_HOME" -ForegroundColor Cyan

# ==========================================
